<resources>
    <style name="Theme.FitLife" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fitlife_midnight</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Real system splash screen (Android splash-screen API); the designed welcome screen is separate -->
    <style name="Theme.FitLife.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fitlife_midnight</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FitLife</item>
    </style>
</resources>
